# ============================================================
# Lab Scheduler - Backend Environment Configuration Template
# ============================================================
# Copy this file to .env or set variables in your shell / CI.
# config.properties (git-ignored) holds DB credentials locally.

# Server port (default: 8080)
PORT=8080

# Database credentials (override config.properties)
DB_URL=jdbc:mysql://localhost:3306/lab_scheduler?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=your_password_here

# Comma-separated list of frontend origins allowed by CORS
# Default: http://localhost:3000 (Next.js dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# In-memory fallback credentials (used only when DB is unavailable)
ADMIN_PASSWORD=admin123
STAFF_PASSWORD=staff123
